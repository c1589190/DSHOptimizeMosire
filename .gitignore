# 依赖与构建产物
# NOTE: do NOT ignore `lib/` globally — the workspace plugin packages keep their
# source entry modules under `packages/*/lib/` (there is no build step), so that
# directory is tracked. Only dependency/build directories are ignored here.
node_modules/
.pnpm-store/
dist/
coverage/
*.tsbuildinfo

# 本机留痕（不进版本库，见 .superpowers/AGENTS.md）
.superpowers/sdd/

# 评测产物
.benchmark-results/
benchmark-results/

# 日志与临时文件
*.log
*.tmp
.DS_Store
