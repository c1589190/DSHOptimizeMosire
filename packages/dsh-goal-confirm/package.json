{
  "name": "@mosire/dsh-goal-confirm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask the Web UI to confirm every automatic goal round: continue, cancel (and delete the goal), or auto-continue after a configurable timeout.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "lib/",
    "locale/",
    "icon.svg",
    "NOTICE",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
