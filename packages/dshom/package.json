{
  "name": "@mosire/dshom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Optimize Mosire (dshom): anchored LiangShen presets, goal-round confirmation, sub-agent control tools, and chat timing annotations in one bundle.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  }
}
